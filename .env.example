# ==============================================================================
# IsoRAG - Environment Configuration
# ==============================================================================
# Copy this file to .env and replace placeholders with production values.
# NEVER commit raw API keys or passwords to version control.

# Application Settings
APP_NAME=IsoRAG
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Redis / RediSearch (Semantic Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false
REDIS_SEMANTIC_CACHE_TTL=86400
REDIS_SEMANTIC_CACHE_INDEX_NAME=isorag:semantic_cache_idx
REDIS_SEMANTIC_CACHE_THRESHOLD=0.08
REDIS_SEMANTIC_CACHE_VECTOR_DIM=384

# Qdrant Vector Store (Tenant Payload Indexing)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=isorag_documents
QDRANT_PREFER_GRPC=false
DENSE_VECTOR_DIM=384

# Embeddings & Reranker Models
DENSE_MODEL_NAME=BAAI/bge-small-en-v1.5
SPARSE_MODEL_NAME=Qdrant/bm25
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

# Hybrid Search & RRF Parameters
HYBRID_TOP_K=25
RERANK_TOP_K=5
RRF_K=60
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3

# Context Compression (LLMLingua-2 / Perplexity Pruner)
ENABLE_CONTEXT_PRUNING=true
PRUNER_TARGET_TOKEN_RATIO=0.6
PRUNER_MODEL_NAME=microsoft/llmlingua-2-xlm-roberta-large-meeting

# LLM Gateway & Simulation Mode
SIMULATION_MODE=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

